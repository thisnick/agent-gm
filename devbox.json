{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.0/.schema/devbox.schema.json",
  "packages": {
    "go": "1.27",
    "golangci-lint": "latest",
    "gopls": "latest",
    "sqlite": "latest",
    "jq": "latest",
    "git": "latest",
    "gnumake": "latest",
    "nodejs": "22",
    "openssl": "latest"
  },
  "env": {
    "GOFLAGS": "-mod=readonly",
    "CGO_ENABLED": "0",
    "AGENT_GM_DATA_DIR": "$PWD/data"
  },
  "shell": {
    "init_hook": [
      "mkdir -p data bin",
      "echo 'agent-gm devbox: go' $(go version 2>/dev/null | cut -d' ' -f3)"
    ],
    "scripts": {
      "build": [
        "go build -trimpath -o bin/agent-gm ./cmd/agent-gm"
      ],
      "fmt": [
        "go fmt ./...",
        "golangci-lint fmt ./... || true"
      ],
      "lint": [
        "golangci-lint run ./..."
      ],
      "vet": [
        "go vet ./..."
      ],
      "test": [
        "CGO_ENABLED=1 go test ./... -race -count=1"
      ],
      "test-live": [
        "CGO_ENABLED=1 AGENT_GM_LIVE=1 go test -tags live ./... -run 'Live' -race -count=1 -v"
      ],
      "check": [
        "go build ./...",
        "go vet ./...",
        "golangci-lint run ./...",
        "CGO_ENABLED=1 go test ./... -race -count=1",
        "./scripts/no-real-numbers.sh"
      ],
      "tidy": [
        "GOFLAGS= go mod tidy"
      ],
      "clean": [
        "rm -rf bin dist"
      ],
      "gen-secret": [
        "openssl rand -hex 32"
      ],
      "conformance": [
        "echo 'the MCP conformance run of spec 8.4 arrives in Slice 3; there is no script yet' >&2",
        "exit 2"
      ],
      "lint-names": [
        "echo 'the name lint of spec 13.5, which reads the served MCP catalogue arrives in Slice 3; there is no script yet' >&2",
        "exit 2"
      ],
      "no-real-numbers": [
        "./scripts/no-real-numbers.sh"
      ],
      "pin-consistency": [
        "./scripts/pin-consistency.sh"
      ],
      "fixture-validation": [
        "./scripts/fixture-validation.sh"
      ],
      "build-matrix": [
        "echo 'the four-platform build of spec 13.6 arrives in Slice 4; there is no script yet' >&2",
        "exit 2"
      ],
      "image": [
        "echo 'the Dockerfile and GHCR push of spec 14.1 arrives in Slice 4; there is no script yet' >&2",
        "exit 2"
      ]
    }
  }
}
