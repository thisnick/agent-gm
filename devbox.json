{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.0/.schema/devbox.schema.json",
  "packages": {
    "go": "1.27",
    "golangci-lint": "latest",
    "gopls": "latest",
    "sqlite": "latest",
    "jq": "latest",
    "git": "latest",
    "gnumake": "latest",
    "nodejs": "22",
    "openssl": "latest"
  },
  "env": {
    "GOFLAGS": "-mod=readonly",
    "CGO_ENABLED": "0",
    "AGENT_GM_DATA_DIR": "$PWD/data"
  },
  "shell": {
    "init_hook": [
      "mkdir -p data bin",
      "echo 'agent-gm devbox: go' $(go version 2>/dev/null | cut -d' ' -f3)"
    ],
    "scripts": {
      "build": [
        "go build -trimpath -o bin/agent-gm ./cmd/agent-gm"
      ],
      "fmt": [
        "go fmt ./...",
        "golangci-lint fmt ./... || true"
      ],
      "lint": [
        "golangci-lint run ./..."
      ],
      "vet": [
        "go vet ./..."
      ],
      "test": [
        "go test ./... -race -count=1"
      ],
      "test-live": [
        "AGENT_GM_LIVE=1 go test -tags live ./... -run 'Live' -race -count=1 -v"
      ],
      "check": [
        "go build ./...",
        "go vet ./...",
        "golangci-lint run ./...",
        "go test ./... -race -count=1"
      ],
      "tidy": [
        "GOFLAGS= go mod tidy"
      ],
      "clean": [
        "rm -rf bin dist"
      ],
      "gen-secret": [
        "openssl rand -hex 32"
      ],
      "conformance": [
        "./scripts/mcp-conformance.sh"
      ],
      "lint-names": [
        "go test ./internal/lint/... -run 'TestNameLint' -count=1"
      ],
      "no-real-numbers": [
        "./scripts/no-real-numbers.sh"
      ]
    }
  }
}
