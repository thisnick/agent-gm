{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.0/.schema/devbox.schema.json",
  "packages": {
    "go": "1.27",
    "golangci-lint": "latest",
    "gopls": "latest",
    "sqlite": "latest",
    "jq": "latest",
    "git": "latest",
    "gnumake": "latest",
    "nodejs": "22",
    "openssl": "latest"
  },
  "env": {
    "GOFLAGS": "-mod=readonly",
    "CGO_ENABLED": "0",
    "AGENT_GM_DATA_DIR": "$PWD/data"
  },
  "shell": {
    "init_hook": [
      "mkdir -p data bin",
      "echo 'agent-gm devbox: go' $(go version 2>/dev/null | cut -d' ' -f3)"
    ],
    "scripts": {
      "build": [
        "go build -trimpath -o bin/agent-gm ./cmd/agent-gm",
        "go build -trimpath -o bin/agm ./cmd/agm"
      ],
      "fmt": [
        "go fmt ./...",
        "golangci-lint fmt ./... || true"
      ],
      "lint": [
        "golangci-lint run ./..."
      ],
      "vet": [
        "go vet ./...",
        "GOOS=windows go vet ./...",
        "GOOS=darwin GOARCH=arm64 go vet ./..."
      ],
      "test": [
        "CGO_ENABLED=1 go test ./... -race -count=1",
        "CGO_ENABLED=1 go -C third_party/mautrix-gmessages test ./pkg/libgm -race -count=1"
      ],
      "test-oauth-browser": [
        "node scripts/oauth-browser-test.mjs"
      ],
      "test-live": [
        "CGO_ENABLED=1 AGENT_GM_LIVE=1 GORACE=\"suppressions=$PWD/scripts/race-suppressions.txt\" go test -tags live ./... -run 'Live' -race -count=1 -v"
      ],
      "check": [
        "go build ./...",
        "go vet ./...",
        "GOOS=windows go vet ./...",
        "GOOS=darwin GOARCH=arm64 go vet ./...",
        "golangci-lint run ./...",
        "CGO_ENABLED=1 go test ./... -race -count=1",
        "CGO_ENABLED=1 go -C third_party/mautrix-gmessages test ./pkg/libgm -race -count=1",
        "./scripts/lint-names.sh",
        "./scripts/no-real-numbers.sh",
        "./scripts/no-deployment-host.sh"
      ],
      "tidy": [
        "GOFLAGS= go mod tidy"
      ],
      "clean": [
        "rm -rf bin dist"
      ],
      "gen-secret": [
        "openssl rand -hex 32"
      ],
      "conformance": [
        "./scripts/conformance.sh"
      ],
      "lint-names": [
        "./scripts/lint-names.sh"
      ],
      "no-real-numbers": [
        "./scripts/no-real-numbers.sh"
      ],
      "no-deployment-host": [
        "./scripts/no-deployment-host.sh"
      ],
      "changeset": [
        "npm install --ignore-scripts --no-audit --no-fund --loglevel=error",
        "npx --no-install changeset"
      ],
      "changeset-version": [
        "npm install --ignore-scripts --no-audit --no-fund --loglevel=error",
        "npm run version-packages"
      ],
      "changeset-check": [
        "./scripts/changeset-check.sh"
      ],
      "cut-tag": [
        "./scripts/cut-tag.sh"
      ],
      "pin-consistency": [
        "./scripts/pin-consistency.sh"
      ],
      "fixture-validation": [
        "./scripts/fixture-validation.sh"
      ],
      "build-matrix": [
        "./scripts/release.sh build"
      ],
      "release-dry-run": [
        "./scripts/release.sh dry-run"
      ],
      "release": [
        "./scripts/release.sh build",
        "./scripts/release.sh sign",
        "./scripts/release.sh npm-pack",
        "./scripts/release.sh publish"
      ],
      "release-npm-publish": [
        "./scripts/release.sh npm-publish"
      ],
      "restore-drill": [
        "./scripts/restore-drill.sh"
      ],
      "image": [
        "./scripts/image.sh"
      ],
      "image-smoke": [
        "./scripts/image.sh smoke"
      ]
    }
  }
}
